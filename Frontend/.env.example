# BuildSmart AI — environment template
#
# PostgreSQL connection. Replace this with the credentials of your local
# PostgreSQL server. The application reads this from Frontend/.env.local (or a
# root .env). Example:
DATABASE_URL="postgresql://postgres:12345678@localhost:5432/build"

# Optional: used by the admin system-health page for storage metrics.
# DATA_DIR="."

# NextAuth / Auth.js
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# For development only - use real services in prod
# AI API keys (never expose client side)
GEMINI_API_KEY="your-google-gemini-api-key-here"
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...

# Roomagen AI Visualization & Floor Plan API (server-side only, never expose client side)
ROOMAGEN_API_KEY=
# Roomagen Provider mode: 'roomagen' (default / live API) or 'mock' (local dev & testing)
ROOMAGEN_PROVIDER=roomagen
# Roomagen API base URL (defaults to https://api.roomagen.com/api/v1)
# ROOMAGEN_BASE_URL=https://api.roomagen.com/api/v1
# Optional Webhook Secret if configured
# ROOMAGEN_WEBHOOK_SECRET=

# Payment provider (Stripe recommended)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# File storage (use S3 or similar for production)
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=

# Email (for verification / notifications)
# RESEND_API_KEY=...
# EMAIL_FROM=noreply@buildsmart.ai
