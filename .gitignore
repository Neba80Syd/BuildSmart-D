# dependencies
/node_modules

# next.js build output (root and Frontend project dir)
.next/
/out
**/.next/

# build / typecheck artifacts
/tsconfig.tsbuildinfo
*.tsbuildinfo

# environment — never commit real secrets
.env
.env.local
.env.*.local

# auto-generated Next.js type declarations
next-env.d.ts
**/next-env.d.ts

# local embedded PostgreSQL data (not committed)
/buildsmart-pgdata
/.buildsmart-pgdata

# prisma generated client/cache
/Backend/prisma/client
/Backend/prisma/generated

# database (dev SQLite file is a binary artifact)
/prisma/dev.db
/prisma/dev.db-journal

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
