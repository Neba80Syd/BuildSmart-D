}

model BoqItem {
  id String @id
  boqId String @map("boq_id")
  category String
  material String
  description String?
  unit String
  quantity Float @default(0)
  unitPrice Float @default(0) @map("unit_price")
  total Float @default(0)
  source String?
  notes String?
  linkedProductId String? @map("linked_product_id")
  createdAt DateTime @map("created_at")
  @@map("boq_items")
}

model Transaction {
  id String @id
  userId String @map("user_id")
  kind String @default("EARNING")
