  updatedAt DateTime @map("updated_at")
  @@map("support_tickets")
}

model Subscription {
  id String @id
  userId String @map("user_id")
  plan String @default("FREE")
  status String @default("ACTIVE")
  startedAt DateTime? @map("started_at")
