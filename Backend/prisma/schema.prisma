// BuildSmart AI — Prisma schema.
// Generated from the existing embedded-PostgreSQL schema. Model/field names
// match the application's dbClient API; @map/@@map bind them to the physical
// tables/columns created by the original data layer so existing rows are
// preserved when Prisma takes over.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgres"
}

model User {
  id String @id
  email String @unique
  name String?
  role String @default("CLIENT")
  passwordHash String? @map("password_hash")
  emailVerified Boolean @default(false) @map("email_verified")
  status String @default("ACTIVE")
  lastActiveAt DateTime? @map("last_active_at")
  adminRole String? @map("admin_role")
  createdAt DateTime @map("created_at")
  @@map("users")
}

model UserProfile {
  id String @id
  userId String @unique @map("user_id")
  location String?
  bio String?
  phone String?
  settings Json?
  @@map("user_profiles")
}

model ArchitectProfile {
  id String @id
  userId String @unique @map("user_id")
  biography String?
  specializations String @default("[]")
  experience Int?
  licenseNumber String? @map("license_number")
  verificationStatus String @default("PENDING") @map("verification_status")
  verifiedAt DateTime? @map("verified_at")
  rating Float @default(0)
  reviewCount Int @default(0) @map("review_count")
  portfolio String @default("[]")
  location String?
  hourlyRate Float @default(0) @map("hourly_rate")
  title String?
  education Json?
  memberships Json?
  languages Json?
  serviceAreas Json? @map("service_areas")
  visibility String @default("PUBLIC")
  credentials Json?
  verificationDocs Json? @map("verification_docs")
  settings Json?
  @@map("architect_profiles")
}

model VendorProfile {
  id String @id
  userId String @unique @map("user_id")
  businessName String @default("") @map("business_name")
  description String?
  location String?
  registrationNumber String? @map("registration_number")
  verificationLevel String @default("UNVERIFIED") @map("verification_level")
  verificationStatus String @default("DRAFT") @map("verification_status")
  verifiedAt DateTime? @map("verified_at")
  rating Float @default(0)
  reviewCount Int @default(0) @map("review_count")
  bannerUrl String? @map("banner_url")
  logoUrl String? @map("logo_url")
  socialLinks Json? @map("social_links")
  taxId String? @map("tax_id")
  shippingPolicy Json? @map("shipping_policy")
  taxSettings Json? @map("tax_settings")
  verificationDocs Json? @map("verification_docs")
  @@map("vendor_profiles")
}

model Product {
  id String @id
  vendorId String @map("vendor_id")
  name String
  description String?
  category String
  unit String
  price Float
  stock Int @default(0)
  imageUrl String? @map("image_url")
  certifications String?
  isActive Boolean @default(true) @map("is_active")
  approvalStatus String @default("APPROVED") @map("approval_status")
  sku String?
  barcode String?
  tags Json?
  attributes Json?
  backorderable Boolean @default(false)
  createdAt DateTime @map("created_at")
  @@map("products")
}

model Project {
  id String @id
  name String
  description String?
  status String @default("DESIGNING")
  ownerId String @map("owner_id")
  architectId String? @map("architect_id")
  budget Float?
  location String?
  progress Int @default(0)
  projectType String? @map("project_type")
  siteArea Float? @map("site_area")
  floors Int?
  rooms Int?
  style String?
  deadline DateTime?
  requirements Json?
  archived Boolean @default(false)
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  @@map("projects")
}

model FloorPlan {
  id String @id
  projectId String @map("project_id")
  name String
  data String?
  svgData String? @map("svg_data")
  kind String @default("2D")
  version Int @default(1)
  status String @default("DRAFT")
  reviewStatus String @default("NOT_STARTED") @map("review_status")
  publishedAt DateTime? @map("published_at")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  @@map("floor_plans")
}

model Cart {
  id String @id
  userId String @unique @map("user_id")
  createdAt DateTime @map("created_at")
  @@map("carts")
}

model CartItem {
  id String @id
  cartId String @map("cart_id")
  productId String @map("product_id")
  quantity Int @default(1)
  createdAt DateTime @map("created_at")
  @@map("cart_items")
}

model ChatRoom {
  id String @id
  projectId String? @map("project_id")
  name String?
  createdAt DateTime @map("created_at")
  @@map("chat_rooms")
}

model ChatParticipant {
  id String @id
  roomId String @map("room_id")
  userId String @map("user_id")
  joinedAt DateTime @map("joined_at")
  @@map("chat_participants")
}

model Message {
  id String @id
  senderId String @map("sender_id")
  roomId String? @map("room_id")
  content String
  read Boolean @default(false)
  createdAt DateTime @map("created_at")
  @@map("messages")
}

model Order {
  id String @id
  userId String @map("user_id")
  status String @default("PENDING")
  totalAmount Float @default(0) @map("total_amount")
  currency String @default("XAF")
  carrier String?
  trackingNumber String? @map("tracking_number")
  shippedAt DateTime? @map("shipped_at")
  fulfilledAt DateTime? @map("fulfilled_at")
  escrowStatus String? @default("ESCROWED") @map("escrow_status")
  confirmationDeadline DateTime? @map("confirmation_deadline")
  createdAt DateTime @map("created_at")
  @@map("orders")
}

model OrderItem {
  id String @id
  orderId String @map("order_id")
  productId String @map("product_id")
  quantity Int
  unitPrice Float @map("unit_price")
  total Float
  @@map("order_items")
}

model Notification {
  id String @id
  userId String @map("user_id")
  type String
  title String
  body String?
  read Boolean @default(false)
  link String?
  resourceId String? @map("resource_id")
  createdAt DateTime @map("created_at")
  @@map("notifications")
}

model Review {
  id String @id
  targetType String @map("target_type")
  targetId String @map("target_id")
  authorId String @map("author_id")
  authorName String? @map("author_name")
  rating Int
  title String?
  body String?
  status String @default("PENDING")
  response String?
  respondedAt DateTime? @map("responded_at")
  createdAt DateTime @map("created_at")
  @@map("reviews")
}

model BlogPost {
  id String @id
  title String
  slug String @unique
  category String?
  excerpt String?
  content String?
  author String?
  status String @default("DRAFT")
  coverImage String? @map("cover_image")
  scheduledAt DateTime? @map("scheduled_at")
  publishedAt DateTime? @map("published_at")
  createdAt DateTime @map("created_at")
  @@map("blog_posts")
}

model SupportTicket {
  id String @id
  userId String @map("user_id")
  subject String
  category String?
  status String @default("OPEN")
  priority String?
  description String?
  messages Json?
  assignedTo String? @map("assigned_to")
  internalNotes Json? @map("internal_notes")
