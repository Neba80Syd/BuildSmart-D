model Coupon {
  id String @id
  vendorId String @map("vendor_id")
  code String
  type String @default("PERCENT")
  value Float @default(0)
  minOrder Float @default(0) @map("min_order")
  maxUses Int @default(0) @map("max_uses")
  usedCount Int @default(0) @map("used_count")
  startsAt DateTime? @map("starts_at")
  endsAt DateTime? @map("ends_at")
  active Boolean @default(true)
  createdAt DateTime @map("created_at")
  @@map("coupons")
}

model Campaign {
  id String @id
  vendorId String @map("vendor_id")
  name String
  type String @default("FLASH_SALE")
  discountType String @default("PERCENT") @map("discount_type")
  discountValue Float @default(0) @map("discount_value")
  startsAt DateTime? @map("starts_at")
  endsAt DateTime? @map("ends_at")
  active Boolean @default(true)
  createdAt DateTime @map("created_at")
  @@map("campaigns")
}

model CrossSell {
  id String @id
  vendorId String @map("vendor_id")
  productId String @map("product_id")
  relatedProductId String @map("related_product_id")
  createdAt DateTime @map("created_at")
  @@map("cross_sells")
}

model ReturnRequest {
  id String @id
  vendorId String @map("vendor_id")
  orderId String @map("order_id")
