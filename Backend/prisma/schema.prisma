  createdAt DateTime @map("created_at")
  @@map("payments")
}

model Document {
  id String @id
  ownerId String @map("owner_id")
  projectId String? @map("project_id")
  name String
  type String
  size Int @default(0)
  category String?
  version Int @default(1)
  content String?
  createdAt DateTime @map("created_at")
  @@map("documents")
}

model ProductMedia {
  id String @id
  vendorId String @map("vendor_id")
  productId String @map("product_id")
  kind String @default("image")
  url String
  name String?
  position Int @default(0)
  createdAt DateTime @map("created_at")
  @@map("product_media")
}

model Warehouse {
  id String @id
  vendorId String @map("vendor_id")
  name String
