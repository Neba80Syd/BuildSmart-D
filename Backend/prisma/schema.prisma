  updatedAt DateTime @map("updated_at")
  @@map("wallet_transactions")
}

model EscrowTransaction {
  id String @id
  escrowType String @default("VENDOR") @map("escrow_type")
  orderId String? @map("order_id")
  walletId String @map("wallet_id")
  vendorId String? @map("vendor_id")
  architectId String? @map("architect_id")
  clientId String @map("client_id")
  projectId String? @map("project_id")
  designId String? @map("design_id")
  milestoneId String? @map("milestone_id")
  paymentId String? @map("payment_id")
  amount Float
  platformFee Float @default(0) @map("platform_fee")
  grossAmount Float @map("gross_amount")
  currency String @default("XAF")
  status String @default("ESCROWED")
  revisionCount Int @default(0) @map("revision_count")
  maxRevisions Int @default(2) @map("max_revisions")
  fundedAt DateTime? @map("funded_at")
  deliveredAt DateTime? @map("delivered_at")
  unlockedAt DateTime? @map("unlocked_at")
  confirmationDeadline DateTime? @map("confirmation_deadline")
  acceptanceDeadline DateTime? @map("acceptance_deadline")
  releasedAt DateTime? @map("released_at")
  refundedAt DateTime? @map("refunded_at")
  disputedAt DateTime? @map("disputed_at")
  releaseReason String? @map("release_reason")
  contentHash String? @map("content_hash")
  autoReleaseEligible Boolean @default(true) @map("auto_release_eligible")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  @@map("escrow_transactions")
}

