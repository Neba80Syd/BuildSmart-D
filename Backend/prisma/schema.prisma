  projectId String? @map("project_id")
  orderId String? @map("order_id")
  escrowId String? @map("escrow_id")
  vendorId String? @map("vendor_id")
  architectId String? @map("architect_id")
  clientId String? @map("client_id")
  designId String? @map("design_id")
  title String
  category String @default("Service Complaint")
  priority String @default("MEDIUM")
  status String @default("OPEN")
  reason String?
  parties Json?
  description String?
  evidence Json?
  vendorResponse String? @map("vendor_response")
  vendorEvidence Json? @map("vendor_evidence")
  vendorRespondedAt DateTime? @map("vendor_responded_at")
  architectResponse String? @map("architect_response")
  architectEvidence Json? @map("architect_evidence")
  architectRespondedAt DateTime? @map("architect_responded_at")
  amount Float? @default(0)
  timeline Json?
  assignedTo String? @map("assigned_to")
  resolution String?
  resolutionType String? @map("resolution_type")
  refundAmount Float? @default(0) @map("refund_amount")
  releaseAmount Float? @default(0) @map("release_amount")
  resolvedAt DateTime? @map("resolved_at")
  resolvedBy String? @map("resolved_by")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  @@map("disputes")
}

model Announcement {
  id String @id
  title String
